# =========================
# MIRx - Git Ignore
# =========================

# -------------------------
# Secrets / credentials
# -------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
*.token
id_rsa*
id_ed25519*
credentials*.json
service-account*.json
*secret*
.huggingface/
.netrc

# -------------------------
# Documents, slides and the paper (private, not part of the code)
# -------------------------
paper/
*.pptx
*.ppt
*.potx
*.odp
*.docx
*.doc
*.dotx
*.odt
*.rtf
*.pdf
*.xlsx
*.xls
*.xlsm
*.ods
*.tex
*.bib
*.cls
~$*

# -------------------------
# Data (never commit the dataset)
# -------------------------
data/

# -------------------------
# Generated artifacts: embeddings, indexes, models, studies
# Large files go to the Hugging Face artifacts repo, not GitHub.
# Only the small JSON configs in artifacts/ are kept.
# -------------------------
artifacts/*
!artifacts/*.json
artifacts/embedding_config.json
artifacts/medcpt_embedding_config.json
*.npy
*.npz
*.parquet
*.safetensors
*.bin
*.pt
*.pth
*.ckpt
*.onnx

# -------------------------
# Notebooks (kept local for now)
# -------------------------
notebooks/
archive/
.ipynb_checkpoints/

# -------------------------
# Local tooling
# -------------------------
deploy/tools/
.claude/

# -------------------------
# Python virtual environments
# -------------------------
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
mIRx-env/
mirx-env/

# -------------------------
# Python cache / compiled files
# -------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

# -------------------------
# Build / packaging
# -------------------------
build/
dist/
*.egg-info/

# -------------------------
# Test / coverage
# -------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# -------------------------
# Logs / temporary files
# -------------------------
*.log
*.tmp
*.temp
*.cache
*.bak
*.swp
*.swo

# -------------------------
# IDE / editor files
# -------------------------
.vscode/
.idea/
*.code-workspace

# -------------------------
# OS generated files
# -------------------------
.DS_Store
Thumbs.db
desktop.ini
